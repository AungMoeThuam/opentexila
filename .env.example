# Public frontend settings only. Never put secrets in VITE_* variables.
VITE_API_BASE_URL=/api/v1
# Explicit opt-in for independent UI work. Ignored in production builds.
# No real API requests are allowed while enabled.
VITE_ENABLE_MOCK_AUTH=false
# Read by Vite configuration only; proxy for local development.
API_PROXY_TARGET=http://127.0.0.1:3000
